<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1020 710" width="1020" height="710" font-family="Helvetica, Arial, sans-serif" font-size="18">
  <rect width="1020" height="710" fill="#fff"/>
  <defs>
    <marker id="open" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="12" markerHeight="12" orient="auto">
      <path d="M0,0 L11,6 L0,12" fill="none" stroke="#000" stroke-width="1.2"/>
    </marker>
  </defs>

  <!-- Cart -->
  <g stroke="#000" stroke-width="3" fill="#FFFFC0">
    <rect x="420" y="30" width="560" height="204"/>
  </g>
  <g stroke="#000" stroke-width="1.2">
    <line x1="420" y1="66" x2="980" y2="66"/>
    <line x1="420" y1="150" x2="980" y2="150"/>
  </g>
  <text x="700" y="55" text-anchor="middle" font-weight="bold" font-size="22">Cart</text>
  <text x="436" y="92"><tspan text-decoration="underline">+ MAX_NUMBERS_ORDERED : int</tspan></text>
  <text x="436" y="116">- qtyOrdered : int</text>
  <text x="436" y="140">- itemsOrdered : DigitalVideoDisc[]</text>
  <text x="436" y="176">+ addDigitalVideoDisc(dvd : DigitalVideoDisc) : void</text>
  <text x="436" y="200">+ removeDigitalVideoDisc(dvd : DigitalVideoDisc) : void</text>
  <text x="436" y="224">+ totalCost() : float</text>

  <!-- Aims -->
  <g stroke="#000" stroke-width="3" fill="#FFFFC0">
    <rect x="40" y="300" width="260" height="96"/>
  </g>
  <g stroke="#000" stroke-width="1.2">
    <line x1="40" y1="336" x2="300" y2="336"/>
    <line x1="40" y1="360" x2="300" y2="360"/>
  </g>
  <text x="170" y="325" text-anchor="middle" font-weight="bold" font-size="22">Aims</text>
  <text x="56" y="386">+ main(args : String[]) : void</text>

  <!-- DigitalVideoDisc -->
  <g stroke="#000" stroke-width="3" fill="#FFFFC0">
    <rect x="500" y="330" width="480" height="348"/>
  </g>
  <g stroke="#000" stroke-width="1.2">
    <line x1="500" y1="366" x2="980" y2="366"/>
    <line x1="500" y1="498" x2="980" y2="498"/>
  </g>
  <text x="740" y="355" text-anchor="middle" font-weight="bold" font-size="22">DigitalVideoDisc</text>
  <text x="516" y="392">- title : String</text>
  <text x="516" y="416">- category : String</text>
  <text x="516" y="440">- director : String</text>
  <text x="516" y="464">- length : int</text>
  <text x="516" y="488">- cost : float</text>
  <text x="516" y="524">+ DigitalVideoDisc()</text>
  <text x="516" y="548">+ DigitalVideoDisc(title : String)</text>
  <text x="516" y="572">+ getTitle() : String</text>
  <text x="516" y="596">+ getCategory() : String</text>
  <text x="516" y="620">+ getDirector() : String</text>
  <text x="516" y="644">+ getLength() : int</text>
  <text x="516" y="668">+ getCost() : float</text>

  <!-- Relationships -->
  <path d="M170,300 L170,110 L420,110" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="8,6" marker-end="url(#open)"/>
  <path d="M170,396 L170,560 L500,560" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="8,6" marker-end="url(#open)"/>
  <line x1="700" y1="234" x2="700" y2="330" stroke="#000" stroke-width="1.5" marker-end="url(#open)"/>
</svg>
